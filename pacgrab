#!/usr/bin/env bash
# pacgrab - Gear Lever-like manager for local PKGBUILDs
# Base: ~/pacgrab/<pkgname>/PKGBUILD
# Usage: pacgrab <list|add|build|update|check|clean|repo|timer-install|...> [args]
set -euo pipefail

BASE="${AUR_LOCAL:-$HOME/pacgrab}"
# pacgrab's own repo: the [NAME] section in /etc/pacman.conf and the db file
# prefix. It must NOT be "local" - libalpm reserves that name for the
# installed-packages database, so a [local] section makes every `pacman -Sy`
# fail with "database already registered" (verified against pacman/libalpm).
REPO_NAME="pacgrab"
DB="$BASE/$REPO_NAME.db.tar.gz"

die() { echo "error: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "missing $1"; }

wait_lock() { # wait up to $1 seconds (default 600) for the pacman db lock
  local timeout="${1:-600}" waited=0
  while [ -e /var/lib/pacman/db.lck ]; do
    if [ "$waited" -ge "$timeout" ]; then
      echo "pacman database still locked after ${timeout}s, giving up" >&2
      return 1
    fi
    [ "$waited" -eq 0 ] && echo "pacman database locked, waiting for it to free up..."
    sleep 5; waited=$((waited+5))
  done
}

pkg_info() { # $1=dir -> "pkgname(s) pkgver-pkgrel"
  bash -c 'source "$1/PKGBUILD" 2>/dev/null || exit 1
    if declare -p pkgname 2>/dev/null | grep -q "declare -a"; then
      echo "${pkgname[*]} $pkgver-$pkgrel"
    else
      echo "$pkgname $pkgver-$pkgrel"
    fi' _ "$1" || echo "? ?"
}

# Every recipe's metadata from ONE bash process. Doing this per recipe cost 19
# `bash -c` spawns plus `grep|head|grep` for the origin check - over a second
# of fork overhead under load - where one spawn covers the whole run (each
# PKGBUILD is read with builtins, no greps). Prints one line per dir:
#   "<dir>\t<pkgname(s) pkgver-pkgrel>\t<grab|aur>"
pkg_report() {
  [ $# -gt 0 ] || return 0
  bash -c 'for d do
      src="$d/PKGBUILD"
      [ -f "$src" ] || continue
      info=$( source "$src" 2>/dev/null &&
              if [[ $(declare -p pkgname 2>/dev/null) == "declare -a"* ]]; then
                printf "%s %s-%s" "${pkgname[*]}" "$pkgver" "$pkgrel"
              else
                printf "%s %s-%s" "$pkgname" "$pkgver" "$pkgrel"
              fi ) || info="? ?"
      # origin: pacgrab generated it - either _pacgrab_* vars anywhere in the
      # file, or the generator header on the first line (AUR imports keep the
      # AUR maintainer line instead)
      origin=aur first="" line=""
      IFS= read -r first < "$src" 2>/dev/null || first=""
      case "$first" in *"@"localhost*) origin=grab ;; esac
      if [ "$origin" = aur ]; then
        while IFS= read -r line || [ -n "$line" ]; do
          case "$line" in _pacgrab_*) origin=grab; break ;; esac
        done < "$src"
      fi
      printf "%s\t%s\t%s\n" "${d%/}" "$info" "$origin"
    done' -- "$@"
}

# Installed versions by package name. `pacman -Q` costs ~0.2s per call, so we
# take every name we care about and ask once - the map is then free to read.
declare -A INSTALLED=()
load_installed() { # $@=pkgnames -> fills INSTALLED
  local n v
  [ $# -gt 0 ] || return 0
  while read -r n v; do
    [ -n "${v:-}" ] && INSTALLED["$n"]="$v"
  done < <(pacman -Q "$@" 2>/dev/null || true)
  return 0
}

# $1=space-separated pkgnames -> the INSTALLED cell for the table
installed_cell() {
  local p n=0 total=0 out=""
  for p in $1; do
    total=$((total+1))
    if [ -n "${INSTALLED[$p]:-}" ]; then
      n=$((n+1))
      out="${out:+$out, }$p ${INSTALLED[$p]}"
    fi
  done
  if [ "$total" -gt 1 ]; then echo "$n/$total installed"
  elif [ -n "$out" ]; then echo "$out"
  else echo "-"
  fi
}

cmd_list() {
  local rows=() base info pns pv p d _origin
  local -a all=()
  # one process for every PKGBUILD instead of one `bash -c` + `basename` per recipe
  while IFS=$'\t' read -r d info _origin; do
    [ -n "$d" ] || continue
    base=${d##*/}
    pv=${info##* }; pns=${info% *}
    rows+=("$base|$pns|$pv")
    for p in $pns; do all+=("$p"); done
  done < <(pkg_report "$BASE"/*/)
  # one pacman call for every recipe, not one per package
  load_installed "${all[@]}"
  local w1=4 w2=10 w3=7 r c1 c2 c3 # headers: BASE PKGNAME(S) VERSION
  for r in "${rows[@]}"; do
    c1=${r%%|*}; r=${r#*|}; c2=${r%%|*}; r=${r#*|}; c3=${r%%|*}
    [ ${#c1} -gt "$w1" ] && w1=${#c1}
    [ ${#c2} -gt "$w2" ] && w2=${#c2}
    [ ${#c3} -gt "$w3" ] && w3=${#c3}
  done
  printf "%-${w1}s %-${w2}s %-${w3}s %s\n" "BASE" "PKGNAME(S)" "VERSION" "INSTALLED"
  for r in "${rows[@]}"; do
    c1=${r%%|*}; r=${r#*|}; c2=${r%%|*}; r=${r#*|}; c3=${r#*|}
    c4=$(installed_cell "$c2")
    printf "%-${w1}s %-${w2}s %-${w3}s %s\n" "$c1" "$c2" "$c3" "$c4"
  done
}

# who owns the handful of paths we care about, asked in ONE pacman call per
# run. Loading whole file lists instead took 0.9s and 4.8MB to answer a
# question about 19 desktop files; `pacman -Qo` answers them all at once.
declare -A OWNER=()
load_owned() { # $@=paths -> OWNER[path]=pkgname
  local line path rest
  [ $# -gt 0 ] || return 0
  while IFS= read -r line; do
    case "$line" in
      *" is owned by "*)
        path=${line%% is owned by *}
        rest=${line#* is owned by }
        OWNER[$path]=${rest% *}
        ;;
    esac
  done < <(pacman -Qo "$@" 2>/dev/null || true)
  return 0
}

# does one of these packages own this exact path? Pure bash lookup, no forks.
ships_path() { # $1=pkgnames (space separated)  $2=path
  local n owner=${OWNER[$2]:-}
  [ -n "$owner" ] || return 1
  for n in $1; do
    if [ "$n" = "$owner" ]; then return 0; fi
  done
  return 1
}

# built package files belonging to a recipe, wherever makepkg put them.
# Globs instead of `makepkg --packagelist`, which costs ~1.7s to spawn.
built_pkgs() { # $1=recipe dir -> paths (may print nothing)
  local d="$1" n info f
  info=$(pkg_info "$d")
  for n in ${info% *}; do
    for f in "$d/$n"-*.pkg.tar.* "$PKGDEST_DIR/$n"-*.pkg.tar.*; do
      if [ -f "$f" ]; then printf '%s\n' "$f"; fi
    done
  done
  return 0
}

# A built package may sit in the recipe dir or, when PKGDEST points elsewhere
# (the ArchWiki per-user ~/.config/pacman/makepkg.conf override, paru/yay), in
# the makepkg cache. Print the path that actually exists.
existing_pkg() { # $1=packagelist path -> path on disk
  if [ -f "$1" ]; then echo "$1"; return 0; fi
  local alt="$PKGDEST_DIR/$(basename "$1")"
  if [ -f "$alt" ]; then echo "$alt"; return 0; fi
  return 1
}

# file paths the recipe's package provides (empty when unknown). Prefers the
# built artifact; without one falls back to the installed package's file list.
# Reached only on sync's icon path, so its single `pacman -Qlq` is fine.
# Never fails - callers run it inside $( ) under `set -e`.
recipe_ships() {
  local d="$1" n info f names
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    pacman -Qlpq "$f" 2>/dev/null || true
    return 0
  done < <(built_pkgs "$d")
  info=$(pkg_info "$d")
  names=${info% *}
  [ -n "$names" ] || return 0
  pacman -Qlq $names 2>/dev/null || true
  return 0
}

# existing, non-directory files the package wants to install but that no
# installed package owns -> exactly the paths pacman rejects with
# "exists in filesystem". One batched `pacman -Qo` call (per 500 paths):
# checking file-by-file costs a process spawn each and takes minutes.
conflicts_of() { # $1=.pkg.tar.zst -> prints offending paths
  local f batch=() out p
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    [ -d "$f" ] && continue
    { [ -e "$f" ] || [ -L "$f" ]; } || continue
    batch+=("$f")
    if [ ${#batch[@]} -ge 500 ]; then
      _unowned_of "${batch[@]}"; batch=()
    fi
  done < <(pacman -Qlpq "$1" 2>/dev/null)
  [ ${#batch[@]} -gt 0 ] && _unowned_of "${batch[@]}"
  return 0
}

_unowned_of() { # $@=existing paths -> print those pacman reports unowned
  local out p
  out=$(pacman -Qo "$@" 2>&1 >/dev/null) || true
  # unowned paths come back on stderr as: error: No package owns /path
  printf '%s\n' "$out" | grep -oP '(?<=No package owns ).*'
}

# `pacgrab sync` installs desktops/icons directly, so unowned copies can sit on
# disk; pacman -U then aborts with "exists in filesystem". Remove such files
# (unowned == no package claims them) right before installing.
purge_conflicts() { # $1=recipe dir
  local d="$1" p f
  local p f
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      echo "  removing unowned file in the way: $f"
      sudo rm -f "$f" || return 1
    done < <(conflicts_of "$p")
  done < <(built_pkgs "$d")
  return 0
}

cmd_build() { # $@=pkgnames
  [ $# -ge 1 ] || die "usage: $0 build <pkgname> [...]"
  need makepkg
  wait_lock || return 1
  local fail=0 name d p q
  local -a outpkgs=() realpkgs=()
  for name in "$@"; do
    d="$BASE/$name"
    if [ ! -f "$d/PKGBUILD" ]; then echo "no PKGBUILD in $d, skipping"; fail=1; continue; fi
    echo "=== $name ==="
    ( cd "$d" && makepkg --printsrcinfo > .SRCINFO && makepkg -scf --noconfirm ) || { echo "FAILED: $name"; fail=1; continue; }
    purge_conflicts "$d" || { echo "FAILED: $name (could not clear conflicts)"; fail=1; continue; }
    mapfile -t outpkgs < <(cd "$d" && makepkg --packagelist 2>/dev/null)
    if [ ${#outpkgs[@]} -eq 0 ]; then echo "FAILED: $name (no package produced)"; fail=1; continue; fi
    # PKGDEST may send artifacts to a cache dir - only install what exists
    realpkgs=()
    for p in "${outpkgs[@]}"; do
      if q=$(existing_pkg "$p"); then realpkgs+=("$q"); fi
    done
    if [ ${#realpkgs[@]} -eq 0 ]; then echo "FAILED: $name (artifact not found on disk)"; fail=1; continue; fi
    # an artifact whose only entries are .PKGINFO/.MTREE/.BUILDINFO means
    # package() extracted nothing: installing it succeeds silently and the app
    # then has no desktop file, no icon and no binary (rofi finds nothing).
    for p in "${realpkgs[@]}"; do
      [ -f "$p" ] || continue
      if ! bsdtar -tf "$p" 2>/dev/null | grep -qvE '^\.(PKGINFO|MTREE|BUILDINFO|INSTALL|CHANGELOG)$'; then
        echo "FAILED: $name ($(basename "$p") is empty - package() installed nothing)"
        fail=1
        continue 2
      fi
    done
    sudo pacman -U --noconfirm "${realpkgs[@]}" || { echo "FAILED: $name"; fail=1; continue; }
    cmd_repo >/dev/null || true
  done
  return $fail
}

cmd_build_all() {
  for d in "$BASE"/*/; do
    [ -f "$d/PKGBUILD" ] || continue
    name=$(basename "$d")
    echo "=== $name ==="
    cmd_build "$name" || echo "FAILED: $name"
  done
}

cmd_uninstall() { # uninstall <name> [--purge]: pacman -R it; source dir stays unless --purge
  [ $# -ge 1 ] || die "usage: $0 uninstall <name> [--purge]"
  local target="$1" pkgs
  if [ -f "$BASE/$target/PKGBUILD" ]; then
    pkgs=$(bash -c 'source "$1/PKGBUILD" 2>/dev/null || exit 1
      if declare -p pkgname 2>/dev/null | grep -q "declare -a"; then echo "${pkgname[@]}"; else echo "$pkgname"; fi' _ "$BASE/$target")
  else
    pkgs="$target" # not a pacgrab dir: try raw pacman name
  fi
  [ -n "$pkgs" ] || die "cannot resolve package for $target"
  wait_lock || return 1
  sudo pacman -Rns --noconfirm $pkgs
  if [ "${2:-}" = "--purge" ] && [ -d "$BASE/$target" ]; then
    rm -rf "$BASE/$target" && echo "purged $BASE/$target"
  fi
  cmd_repo >/dev/null 2>&1 || true
}

cmd_bump() { # bump <pkg> [newver]: github via API, or explicit version for pinned URLs
  local d gh latest current
  if [ $# -eq 2 ]; then
    d="$BASE/$1"; local newver="$2"
    [ -f "$d/PKGBUILD" ] || die "no PKGBUILD in $d"
    # tight charset: this value is pasted into a sed replacement and into URL path
    # segments - '/' or '&' there would corrupt the PKGBUILD or abort sed mid-write
    [[ "$newver" =~ ^[0-9][0-9A-Za-z._+-]*$ ]] || die "invalid version '$newver' (letters, digits and ._+- only)"
    current=$( ( source "$d/PKGBUILD" 2>/dev/null && echo "$pkgver" ) ) \
      || die "$d/PKGBUILD is not sourceable - fix it first"
    [ "$newver" != "$current" ] || { echo "$1 already at $current"; return 0; }
    echo "$1: $current -> $newver"
    need updpkgsums
    # anchor to pkgver=: the old unanchored s/$current/$newver/g also rewrote
    # _pacgrab_url/pkgdesc and digits INSIDE sha256sums, and an unescaped '.' in
    # the pattern matched any character. URL-ish lines are swapped on purpose
    # (pinned links carry the version in their path).
    local esc_cur; esc_cur=$(printf '%s' "$current" | sed 's/[][\.*^$]/\\&/g')
    sed -i "s/^pkgver=.*/pkgver=$newver/; s/^pkgrel=.*/pkgrel=1/" "$d/PKGBUILD"
    sed -i "/^\(source\|_pacgrab_url\|url\|pkgdesc\)=/s|$esc_cur|$newver|g" "$d/PKGBUILD"
    grep -q "^pkgver=$newver$" "$d/PKGBUILD" || die "bump failed: pkgver not written to $d/PKGBUILD"
    ( cd "$d" && updpkgsums && makepkg --printsrcinfo > .SRCINFO ) \
      || die "bump failed: could not refresh checksums in $d"
    return 0
  fi
  [ $# -eq 1 ] || die "usage: $0 bump <pkgname> [new-version]"
  d="$BASE/$1"
  [ -f "$d/PKGBUILD" ] || die "no PKGBUILD in $d"
  need curl; need updpkgsums
  gh=$(grep -oP '^_github="\K[^"]+' "$d/PKGBUILD" || true)
  [ -n "$gh" ] || die "no _github=\"OWNER/REPO\" in PKGBUILD"
  latest=$(curl -fsSL "https://api.github.com/repos/$gh/releases/latest" | grep -oP '"tag_name":\s*"\Kv?[\d.]+' | head -1 || true)
  [ -n "$latest" ] || die "could not fetch latest release for $gh"
  latest=${latest#v}
  current=$( ( source "$d/PKGBUILD" 2>/dev/null && echo "$pkgver" ) ) \
    || die "$d/PKGBUILD is not sourceable - fix it first"
  if [ "$latest" = "$current" ]; then echo "$1 already at $current"; return 0; fi
  echo "$1: $current -> $latest"
  sed -i "s/^pkgver=.*/pkgver=$latest/; s/^pkgrel=.*/pkgrel=1/" "$d/PKGBUILD"
  # subshell so the leaked `cd` can't move the script's cwd, and so a failed
  # updpkgsums is reported instead of leaving pkgver bumped with stale sums
  ( cd "$d" && updpkgsums && makepkg --printsrcinfo > .SRCINFO ) \
    || die "bump failed: could not refresh checksums in $d"
}

norm_ver() { printf '%s' "$1" | grep -oP '^\d+(\.\d+){0,3}' | awk -F. '{printf "%d.%d.%d", $1, $2+0, $3+0}'; }

# $1=recipe dir -> print that recipe's one-line update status
check_one() {
  local d="$1" name gh cu cr current latest body rc=0
  name=$(basename "$d")
  gh=$(grep -oP '^_github="\K[^"]+' "$d/PKGBUILD" 2>/dev/null || true)
  if [ -n "$gh" ]; then
    current=$( ( source "$d/PKGBUILD" 2>/dev/null && echo "$pkgver" ) ) \
      || { echo "$name: check failed - PKGBUILD not sourceable"; return 0; }
    # a status check must never hang the command; and a failed fetch must not
    # be reported as "up to date" (github rate-limits unauthenticated clients)
    body=$(curl -fsSL --connect-timeout 5 --max-time 15 \
      "https://api.github.com/repos/$gh/releases/latest" 2>/dev/null) || rc=$?
    if [ "$rc" -ne 0 ]; then
      if [ "$rc" -eq 22 ]; then
        echo "$name: check failed - github said no (rate limited? $current unchanged)"
      else
        echo "$name: check failed - github unreachable (rc=$rc, $current unchanged)"
      fi
      return 0
    fi
    latest=$(printf '%s' "$body" | grep -oP '"tag_name":\s*"\Kv?[\d.]+' | head -1 || true)
    latest=${latest#v}
    if [ -n "$latest" ] && [ "$latest" != "$current" ]; then
      echo "$name: $current -> $latest ($gh)"
    else
      echo "$name: up to date ($current)"
    fi
    return 0
  fi
  # pinned-URL packages with a version feed (_check_url + _check_regex)
  cu=$(grep -oP '^_check_url="\K[^"]+' "$d/PKGBUILD" 2>/dev/null || true)
  current=$( ( source "$d/PKGBUILD" 2>/dev/null && echo "$pkgver" ) ) \
    || { echo "$name: check failed - PKGBUILD not sourceable"; return 0; }
  if [ -z "$cu" ]; then
    # nothing to ask: a bare `return 0` here made check print only 8 of 20 lines,
    # so report what IS knowable - the recipe's own version - instead of silence
    if grep -q '^pkgver()' "$d/PKGBUILD" 2>/dev/null; then
      echo "$name: VCS recipe (pkgver set at build, run: $0 build $name)"
    else
      echo "$name: no version feed ($current)"
    fi
    return 0
  fi
  cr=$(grep -oP '^_check_regex=\K.*' "$d/PKGBUILD" 2>/dev/null | sed "s/^'//; s/'$//" || true)
  rc=0
  body=$(curl -fsSL --compressed --connect-timeout 5 --max-time 15 "$cu" 2>/dev/null) || rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "$name: check failed - could not reach the version feed (rc=$rc, $current unchanged)"
    return 0
  fi
  latest=$(printf '%s\n' "$body" | grep -oP "$cr" | head -1 || true)
  if [ -n "$latest" ] && [ "$(norm_ver "$latest")" != "$(norm_ver "$current")" ]; then
    echo "$name: $current -> $latest available (re-pacgrab the new link)"
  else
    echo "$name: up to date ($current)"
  fi
}

cmd_check() { # check for updates without bumping
  # each recipe talks to a different server - run the lookups together rather
  # than one curl after another, then print in directory order
  local d outdir i=0 f
  outdir=$(mktemp -d "${TMPDIR:-/tmp}/pacgrab-check-XXXXXX") || return 1
  for d in "$BASE"/*/; do
    [ -f "$d/PKGBUILD" ] || continue
    ( check_one "$d" >"$outdir/$i" ) &
    i=$((i+1))
  done
  wait || true
  for ((f=0; f<i; f++)); do
    if [ -f "$outdir/$f" ]; then cat "$outdir/$f"; fi
  done
  rm -rf "$outdir"
}

cmd_edit() {
  [ $# -eq 1 ] || die "usage: $0 edit <pkgname>"
  "${EDITOR:-nano}" "$BASE/$1/PKGBUILD"
}

cmd_new() { # new <pkgname-bin> OWNER/REPO
  [ $# -eq 2 ] || die "usage: $0 new <pkgname-bin> OWNER/REPO"
  name="$1"; gh="$2"
  d="$BASE/$name"
  [ -e "$d" ] && die "$d exists"
  mkdir -p "$d"
  cat > "$d/PKGBUILD" <<EOF
# Maintainer: $(whoami) <$(whoami)@localhost>
pkgname=$name
pkgver=0.1.0
pkgrel=1
pkgdesc="$name built locally from GitHub releases"
arch=('x86_64')
url="https://github.com/$gh"
license=('custom')
depends=('hicolor-icon-theme')
options=('!strip')
_github="$gh"
# EDIT: point to the real release asset, then run updpkgsums
source=("\$pkgname-\$pkgver.tar.gz::https://github.com/$gh/releases/download/v\$pkgver/")
sha256sums=('SKIP')

package() {
  cd "\$srcdir"
  install -dm755 "\$pkgdir/opt/\$pkgname" "\$pkgdir/usr/bin"
  cp -a * "\$pkgdir/opt/\$pkgname/"
  ln -s "/opt/\$pkgname/\$pkgname" "\$pkgdir/usr/bin/\$pkgname"
}
EOF
  cat > "$d/$name.desktop" <<EOF
[Desktop Entry]
Name=$name
Exec=/usr/bin/$name
Type=Application
Categories=Utility;
EOF
  echo "created $d/PKGBUILD - edit source() then: $0 build $name"
}

PKGDEST_DIR="${PKGDEST:-${XDG_CACHE_HOME:-$HOME/.cache}/makepkg/pkg}"

cmd_clean() {
  find "$BASE" -maxdepth 2 -name '*.pkg.tar.zst*' -delete
  # the index must not outlive its files: an entry whose package is gone makes
  # `pacman -S` fail with "failed retrieving file", makes `pacman -Syu` abort
  # on it, and makes `pacgrab -S` report "provided by [$REPO_NAME]" as a silent
  # no-op. Keep an empty-but-present db: once the repo is configured, a
  # missing $REPO_NAME.db makes `pacman -Sy` fail for every repo.
  if compgen -G "$BASE/*.pkg.tar.zst" >/dev/null; then
    cmd_repo >/dev/null || true
  else
    tar czf "$BASE/$REPO_NAME.db.tar.gz" --files-from /dev/null
    tar czf "$BASE/$REPO_NAME.files.tar.gz" --files-from /dev/null
    rm -f "$BASE/${REPO_NAME}.db.tar.gz.old" "$BASE/${REPO_NAME}.files.tar.gz.old"
    # repo-add normally creates these; a plain tar does not, and without
    # $REPO_NAME.db there is nothing for `pacman -Sy` to fetch
    ln -sf "$REPO_NAME.db.tar.gz" "$BASE/$REPO_NAME.db"
    ln -sf "$REPO_NAME.files.tar.gz" "$BASE/$REPO_NAME.files"
  fi
  for d in "$BASE"/*/; do
    [ -d "$d" ] || continue
    rm -rf "$d/src" "$d/pkg"
  done
  rm -rf "${TMPDIR:-/tmp}"/pacgrab-add* "${TMPDIR:-/tmp}"/aur-migrate
  rm -f "${SRCDEST:-${XDG_CACHE_HOME:-$HOME/.cache}/makepkg/src}"/*.part
  echo "cleaned pacgrab dirs + /tmp. Cache kept at $PKGDEST_DIR ($(du -sh "$PKGDEST_DIR" 2>/dev/null | cut -f1))."
}

cmd_repo() {
  need repo-add
  mapfile -t pkgs < <(find "$BASE" "$PKGDEST_DIR" -maxdepth 3 -name '*.pkg.tar.zst' ! -name '*-debug-*' 2>/dev/null | sort -u)
  [ ${#pkgs[@]} -gt 0 ] || { echo "no packages to add"; return 0; }
  # pacman downloads <Server>/<%FILENAME%> and FILENAME is only the basename,
  # so the pool has to be flat under Server: makepkg puts artifacts in the
  # recipe dir (or in PKGDEST), so hardlink them into $BASE and index the
  # link - a hardlink, not a copy, so it costs no disk space. Once linked,
  # find() sees both the link and the original, hence the basename dedupe.
  local p f
  local -A seen=()
  local -a flat=()
  for p in "${pkgs[@]}"; do
    f="$BASE/${p##*/}"
    if [ -n "${seen[$f]:-}" ]; then continue; fi
    seen[$f]=1
    if [ "$p" != "$f" ]; then
      ln -f "$p" "$f" 2>/dev/null || { rm -f "$f"; cp -p "$p" "$f" 2>/dev/null || continue; }
    fi
    flat+=("$f")
  done
  cd "$BASE"
  repo-add -q -R "$REPO_NAME.db.tar.gz" "${flat[@]}"
  echo "repo updated: ${#flat[@]} package(s). Add to /etc/pacman.conf:"
  echo "  [$REPO_NAME]"
  echo '  SigLevel = Optional TrustAll'
  echo "  Server = file://$BASE"
  if grep -q '^\[local\]' /etc/pacman.conf 2>/dev/null; then
    echo "  WARNING: /etc/pacman.conf already has a [local] section - libalpm"
    echo "           reserves that name, so 'pacman -Sy' fails for every repo."
    echo "           Remove it and use [$REPO_NAME] instead."
  fi
  return 0
}

# One-time setup: create the base dir + an empty repo db, and add the
# [pacgrab] section to /etc/pacman.conf (with sudo). Idempotent - safe to run
# again; existing pieces are left alone. This is what `install.sh` calls so a
# fresh install needs no hand-editing of pacman.conf.
print_pacman_section() {
  echo "  [$REPO_NAME]"
  echo "  SigLevel = Optional TrustAll"
  echo "  Server = file://$BASE"
}

cmd_setup() {
  mkdir -p "$BASE"
  # empty-but-present db: once the [pacgrab] section exists, a missing or
  # dangling $REPO_NAME.db makes `pacman -Sy` fail for every repo. Rebuild the
  # empty db whenever no packages exist (cheap, idempotent) so a partial state
  # left by an interrupted run is repaired, not skipped. When packages DO
  # exist, leave the real repo db alone - `pacgrab repo` manages that.
  if compgen -G "$BASE/*.pkg.tar.zst" >/dev/null; then
    echo "repo db present ($BASE) - 'pacgrab repo' reindexes it after builds"
  else
    rm -f "$BASE/$REPO_NAME.db" "$BASE/$REPO_NAME.files"  # drop any dangling links
    tar czf "$BASE/$REPO_NAME.db.tar.gz" --files-from /dev/null
    tar czf "$BASE/$REPO_NAME.files.tar.gz" --files-from /dev/null
    ln -sf "$REPO_NAME.db.tar.gz" "$BASE/$REPO_NAME.db"
    ln -sf "$REPO_NAME.files.tar.gz" "$BASE/$REPO_NAME.files"
    echo "seeded empty repo db in $BASE"
  fi
  # conf path overridable for testing / containers (default: system pacman.conf)
  local conf="${PACGRAB_PACMAN_CONF:-/etc/pacman.conf}"
  if [ ! -f "$conf" ]; then
    echo "note: $conf not found - add this section manually:"
    print_pacman_section
    return 0
  fi
  if grep -q "^\[$REPO_NAME\]" "$conf" 2>/dev/null; then
    echo "[$REPO_NAME] already present in $conf"
  else
    if grep -q '^\[local\]' "$conf" 2>/dev/null; then
      echo "WARNING: $conf has a [local] section - libalpm reserves that name,"
      echo "         so 'pacman -Sy' fails for every repo. Remove it."
    fi
    echo "appending [$REPO_NAME] to $conf..."
    if [ -w "$conf" ]; then
      # already writable (root, or a sandboxed/test conf): append directly
      printf '\n[%s]\nSigLevel = Optional TrustAll\nServer = file://%s\n' \
        "$REPO_NAME" "$BASE" >>"$conf" || die "could not write $conf"
    else
      # needs root: `sudo tee -a`, not `sudo >>` - the redirect must run as
      # root and tee reads the block from this pipe. sudo takes its password
      # from the tty, not this pipe, so the piped installer cannot feed it.
      # Leading \n guards a missing final newline in the target.
      printf '\n[%s]\nSigLevel = Optional TrustAll\nServer = file://%s\n' \
        "$REPO_NAME" "$BASE" | sudo tee -a "$conf" >/dev/null \
        || die "could not write $conf (need sudo)"
    fi
    echo "added [$REPO_NAME] to $conf"
  fi
  echo "next: sudo pacman -Sy   (then: pacgrab <url> to install an app)"
  return 0
}

# Paste a release URL (GitHub or any direct download) -> installs the app.
# GitHub URLs also register for autoupdates. Generic URLs install fine but bump manually.
# usage: install <url> [pkgname] [--no-build]
cmd_add() {
  need curl; need bsdtar; need makepkg
  local url="${1:-}" force_name="${2:-}" nobuild=0
  [ -n "$url" ] || die "usage: $0 install <url> [pkgname] [--no-build]"
  if [ "$force_name" = "--no-build" ]; then force_name=""; nobuild=1; fi
  if [ "${3:-}" = "--no-build" ]; then nobuild=1; fi

  local gh="" tag="" asset aurl ver srcurl
  if [[ "$url" =~ github\.com/([^/]+/[^/]+)/releases/download/([^/]+)/(.+)$ ]]; then
    gh="${BASH_REMATCH[1]}"; tag="${BASH_REMATCH[2]}"; asset="${BASH_REMATCH[3]}"; aurl="$url"
    ver="${tag#v}"; ver="${ver//-/_}"
    local atmpl="${asset//$tag/v\$pkgver}"; [[ "$tag" == v* ]] || atmpl="${asset//$tag/\$pkgver}"
    if [[ "$atmpl" == "$asset" ]]; then atmpl="${asset//$ver/\$pkgver}"; fi
    if [[ "$tag" == v* ]]; then srcurl="https://github.com/$gh/releases/download/v\$pkgver/$atmpl"
    else srcurl="https://github.com/$gh/releases/download/\$pkgver/$atmpl"; fi
  elif [[ "$url" =~ github\.com/([^/]+/[^/]+?)(/.*)?$ ]]; then
    gh="${BASH_REMATCH[1]}"
    echo "resolving latest release for $gh..."
    local json
    json=$(curl -fsSL "https://api.github.com/repos/$gh/releases/latest") || die "GitHub API failed"
    tag=$(printf '%s' "$json" | grep -oP '"tag_name":\s*"\K[^"]+' | head -1 || true)
    [ -n "$tag" ] || die "no releases for $gh"
    mapfile -t cands < <(printf '%s' "$json" | grep -oP '"browser_download_url":\s*"\K[^"]+')
    aurl=$(printf '%s\n' "${cands[@]}" | grep -iP 'linux|x86_64|amd64|appimage|\.deb$' | grep -viP 'arm|aarch64|darwin|macos|windows|\.exe|source|\.rpm$' | grep -iP '\.tar\.gz$|\.tgz$|\.tar\.xz$|\.AppImage$|\.deb$|\.zip$' | head -1 || true)
    [ -n "$aurl" ] || aurl=$(printf '%s\n' "${cands[@]}" | head -1)
    [ -n "$aurl" ] || die "no downloadable asset in latest release"
    asset="${aurl##*/}"
    echo "picked: $asset ($tag)"
    ver="${tag#v}"; ver="${ver//-/_}"
    local atmpl="${asset//$tag/v\$pkgver}"; [[ "$tag" == v* ]] || atmpl="${asset//$tag/\$pkgver}"
    if [[ "$atmpl" == "$asset" ]]; then atmpl="${asset//$ver/\$pkgver}"; fi
    if [[ "$tag" == v* ]]; then srcurl="https://github.com/$gh/releases/download/v\$pkgver/$atmpl"
    else srcurl="https://github.com/$gh/releases/download/\$pkgver/$atmpl"; fi
  elif [[ "$url" =~ ^https?:// ]]; then
    echo "generic URL (no GitHub autoupdate - bump manually with edit + build)"
    aurl="$url"
    asset="${aurl%%\?*}"; asset="${asset##*/}"
    [ -n "$asset" ] || die "cannot derive filename from URL"
    ver=$(printf '%s' "$url" | grep -oP '\d+\.\d+(\.\d+){0,3}' | head -1 || true)
    [ -n "$ver" ] || { ver="1.0.0"; echo "warn: no version in URL, using $ver (edit PKGBUILD)"; }
    srcurl="$url" # pinned: generic hosts rarely keep a stable versioned pattern
  else
    die "not an http(s) URL: $url"
  fi
  asset=$(printf '%b' "${asset//%/\\x}") # decode %20 etc. into real characters
  # default pkgname from asset: strip version, arch, extension, then -bin
  # (asset/ver may be refined after download for generic URLs; see below)
  local srcdest="${SRCDEST:-${XDG_CACHE_HOME:-$HOME/.cache}/makepkg/src}"
  mkdir -p "$srcdest"
  local tmp; tmp=$(mktemp -d "${TMPDIR:-/tmp}/pacgrab-add-XXXXXX")
  if [ -z "$gh" ]; then
    # cheap redirect resolution so query-string URLs get their real filename
    local eff
    eff=$(curl -fsSIL --retry 3 --retry-all-errors --retry-delay 2 -o /dev/null -w '%{url_effective}' "$aurl" 2>/dev/null || true)
    [ -n "$eff" ] || eff="$aurl"
    local effbase="${eff%%\?*}"; effbase="${effbase##*/}"
    effbase=$(printf '%b' "${effbase//%/\\x}") # decode %20 etc.
    if [[ "$effbase" =~ \.(tar\.gz|tgz|tar\.xz|tar\.bz2|zip|deb|AppImage|rpm)$ ]]; then
      asset="$effbase"
      ver=$(printf '%s' "$eff" | grep -oP '\d+\.\d+(\.\d+){0,3}' | head -1 || true)
      [ -n "$ver" ] || ver="1.0.0"
    fi
    echo "resolved: $asset ($ver)"
  fi
  # deterministic cache path: reuse across runs, resume partials
  local final="$srcdest/$asset"
  if [ ! -f "$final" ]; then
    # tolerate a previously cached percent-encoded twin (same bytes, %20 name)
    for twin in "$srcdest"/*; do
      [ -f "$twin" ] || continue
      tb="${twin##*/}"
      if [ "$(printf '%b' "${tb//%/\\x}")" = "$asset" ]; then
        echo "reusing cached twin $tb"
        cp -a "$twin" "$final"
        [ -f "$twin.url" ] && cp -a "$twin.url" "$final.url"
        break
      fi
    done
  fi
  # remember which URL produced a cached blob: the cache key is the filename only,
  # and that is constant for URLs whose path carries no version (rolling "latest"
  # endpoints, vendor paths with a build id) - without this, refresh skips the
  # download and re-hashes stale bytes into sha256sums, which makepkg then rejects.
  local want_url="${eff:-$aurl}"
  if [ -f "$final" ] && { [ ! -f "$final.url" ] || [ "$(cat "$final.url")" != "$want_url" ]; }; then
    echo "cached source is from a different URL, re-downloading $asset"
    rm -f "$final" "$final.part" "$final.url"
  fi
  local dl="$final.part"
  if [ -f "$final" ]; then
    echo "using cached $asset, skipping download"
  else
    echo "downloading $asset..."
    [ -f "$dl" ] && echo "resuming from $(du -h "$dl" | cut -f1)"
    curl -fSL --retry 5 --retry-all-errors --retry-delay 5 -C - -o "$dl" "$aurl" || die "download failed"
    if [[ "$asset" != *.* ]] && bsdtar -tf "$dl" >/dev/null 2>&1; then
      asset="$asset.tar.gz" # sniffed archive, unknown extension
    fi
    final="$srcdest/$asset"; mv "$dl" "$final"
    printf '%s' "$want_url" > "$final.url"
  fi
  local sum; sum=$(sha256sum "$final" | cut -d' ' -f1)
  ln -sf "$final" "$tmp/$asset" # inspect from tmp, source of truth stays in srcdest cache

  local stem="$asset" name
  stem="${stem%.tar.gz}"; stem="${stem%.tgz}"; stem="${stem%.tar.xz}"; stem="${stem%.zip}"; stem="${stem%.deb}"; stem="${stem%.AppImage}"
  stem="${stem//-/_}"; stem="${stem//$ver/}" # remove version if embedded
  stem=$(printf '%s' "$stem" | sed -E 's/[-_]+(linux|x86_64|amd64|aarch64|arm64|unknown|musl|darwin|windows|apple|pc|static|gnu).*//I; s/[-_]+v$//I; s/[-_.]+$//; s/[-_[:space:]]+/-/g')
  stem=$(printf '%s' "$stem" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9@._+-]/-/g; s/-+/-/g')
  [ -n "$stem" ] || stem="app"
  name="${force_name:-${stem}-bin}"
  local d="$BASE/$name"
  if [ -e "$d" ]; then
    if pacman -Q "$name" >/dev/null 2>&1; then
      die "$d exists and $name is installed (pacgrab build $name to reinstall)"
    else
      echo "$d exists but $name is not installed - building..."
      cmd_build "$name"
      return 0
    fi
  fi

  echo "inspecting..."
  local listing="$tmp/listing.txt"
  local kind="unknown" top="" binname="" binpath="" desktop="" icon_rel="" icon_full=""
  : > "$listing" # deb/appimage list no archive, but the greps below still run
  if [[ "$asset" == *.AppImage ]]; then
    kind="appimage"
    chmod +x "$tmp/$asset"
    ( cd "$tmp" && "./$asset" --appimage-extract '*.desktop' '*.png' '*.svg' >/dev/null 2>&1 ) || true
    desktop=$(find "$tmp/squashfs-root" -maxdepth 1 -name '*.desktop' -printf '%f\n' 2>/dev/null | head -1)
    binname="${desktop%.desktop}"; [ -z "$binname" ] && binname="$stem"
  elif [[ "$asset" == *.deb ]]; then
    kind="deb"
  else
    if ! bsdtar -tf "$tmp/$asset" > "$listing" 2>/dev/null; then
      if [ "$(head -c 4 "$tmp/$asset")" = "$(printf '\177ELF')" ]; then
        kind="rawbin" # bare ELF like sonora's release asset: straight to /usr/bin
        binname="${name%-bin}"
      else
        die "cannot list archive $asset (not a supported archive or binary?)"
      fi
    else
    top=$(head -1 "$listing" | cut -d/ -f1)
    if grep -q "^$top/bin/" "$listing" && grep -q "^$top/share/" "$listing"; then
      kind="structured" # like artcraft: bin/ + share/
      binname=$(grep -oP "^$top/bin/\K[^/]+" "$listing" | head -1 || true)
      binpath="bin/$binname"
    elif grep -q "share/applications/.*\.desktop$" "$listing"; then
      kind="structured"
      desktop=$(grep -oP "share/applications/\K.*\.desktop$" "$listing" | head -1 || true)
      binname=$(grep -oP "^$top/bin/\K[^/]+" "$listing" | head -1 || true)
      [ -z "$binname" ] && binname="$stem"
      binpath="bin/$binname"
    elif grep -qE '(^|/)(index\.theme|cursor\.theme)$' "$listing" && grep -qE '(^|/)cursors/$' "$listing"; then
      kind="cursortheme" # cursor/icon theme: theme dirs -> /usr/share/icons, no binary/desktop
      binname="$stem"
    elif grep -q "^$top/bin/.*\.sh$" "$listing"; then      kind="opttree" # like android-studio: whole tree -> /opt, launcher script symlinked
      binpath=$(grep -oP "^$top/bin/\K[^/]+" "$listing" | grep -i "$stem" | head -1 || true)
      [ -z "$binpath" ] && binpath=$(grep -oP "^$top/bin/\K[^/]+\.sh$" "$listing" | head -1 || true)
      [ -z "$binpath" ] && binpath=$(grep -oP "^$top/bin/\K[^/]+" "$listing" | head -1 || true)
      binpath="bin/$binpath"
      binname="${name%-bin}"
    else
      # apptree like discord: launcher binary matching app name somewhere in tree
      # dash/underscore-insensitive both ways (stem discordcanary = file discord-canary)
      local fuzzy; fuzzy=$(printf '%s' "$stem" | sed 's/./&[ _-]?/g')
      binpath=$(grep -v '/$' "$listing" | grep -viP '/(man|doc|include|tests?|examples?|locale|assets|static|completions)/' | grep -iP "^$top/(.*/)?[^/]*$fuzzy[^/]*$" | grep -viP '\.(png|svg|xpm|ico|gif|jpe?g|webp|bmp|tiff|mp4|webm|mkv|ogg|mp3|wav|flac|opus|ttf|otf|woff2?|txt|md|html|desktop|xml|json|c|h|o|a|m4|am|in|ac|la|pc|[1-9]|so(\..*)?)$' | awk -F/ '{print NF-1, $0}' | sort -n | cut -d' ' -f2- | head -1 || true)
      if [ -n "$binpath" ]; then
        kind="opttree"
        local _ldir="${binpath%/*}"
        binpath="${binpath#$top/}"; binname="${name%-bin}"
        [ -z "$icon_rel" ] && icon_rel=$(grep -oP "^${_ldir}/[^/]+\.(png|svg)$" "$listing" | head -1 || true)
      else
        # single binary: top-level file, else the lone file one level down
        binname=$(grep -v '/$' "$listing" | grep -v '/' | head -1 | xargs basename 2>/dev/null || true)
        kind="singlebin"; binpath=""
        if [ -z "$binname" ]; then
          binpath=$(grep -v '/$' "$listing" | head -1 || true)
          binpath="${binpath#$top/}"; binname="$(basename "$binpath")"
        fi
      fi
    fi
    # icon: prefer share icons, else bin/ art, else beside the launcher
    [ -z "$icon_rel" ] && icon_rel=$(grep -oP "^$top/share/icons/hicolor/[^ ]+\.(png|svg)$" "$listing" | head -1 || true)
    [ -z "$icon_rel" ] && icon_rel=$(grep -oP "^$top/share/pixmaps/[^ ]+\.(png|svg|xpm)$" "$listing" | head -1 || true)
    [ -z "$icon_rel" ] && icon_rel=$(grep -oP "^$top/bin/[^/]+\.(png|svg)$" "$listing" | head -1 || true)
    if [ -z "$icon_rel" ] && [ -n "${binpath:-}" ]; then
      icon_rel=$(grep -oP "^$top/${binpath%/*}/[^/]+\.(png|svg)$" "$listing" | head -1 || true)
    fi
    # deep fallbacks, shallowest first: app-named art, linux resource dirs, icon/logo files
    [ -z "$icon_rel" ] && icon_rel=$(grep -iP "^.*/[^/]*$binname[^/]*\.(png|svg)$" "$listing" | awk -F/ '{print NF-1, $0}' | sort -n | cut -d' ' -f2- | head -1 || true)
    [ -z "$icon_rel" ] && icon_rel=$(grep -iP "^$top/.*linux/[^/]*\.(png|svg)$" "$listing" | awk -F/ '{print NF-1, $0}' | sort -n | cut -d' ' -f2- | head -1 || true)
    [ -z "$icon_rel" ] && icon_rel=$(grep -iP "^$top/.*(icon|logo)[^/]*\.(png|svg)$" "$listing" | awk -F/ '{print NF-1, $0}' | sort -n | cut -d' ' -f2- | head -1 || true)
    icon_full="$icon_rel"
    icon_rel="${icon_rel#$top/}"
    fi # bsdtar listable
  fi
  [ -n "$binname" ] || binname="$stem"
  # display name for .desktop: Title Case, dashes -> spaces
  local display; display=$(printf '%s' "$binname" | tr '-' ' ' | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) substr($i,2)}1' | sed -E 's/\bIde\b/IDE/g; s/\bHd\b/HD/g; s/\b4k\b/4K/g; s/\b3d\b/3D/g; s/\bTv\b/TV/g; s/\bApi\b/API/g')
  echo "layout: $kind, launcher: ${binpath:-$binname}"

  local lic="custom"
  grep -qi 'LICENSE-MIT' "$listing" 2>/dev/null && lic="MIT"
  grep -qi 'LICENSE-APACHE' "$listing" 2>/dev/null && lic="'MIT' 'Apache-2.0'"

  mkdir -p "$d"
  # repo icon fallback: asset ships none but _github repo has one (e.g. doc/topgrade.png)
  local iconsrc="" iconsum="" iconinst=""
  if [ -z "$icon_rel" ] && [ -n "$gh" ] && [[ "$kind" != deb && "$kind" != appimage && "$kind" != cursortheme ]]; then
    local tree pick
    tree=$(curl -fsSL "https://api.github.com/repos/$gh/git/trees/HEAD?recursive=1" 2>/dev/null | grep -oP '"path":\s*"\K[^"]+\.(png|svg)' || true)
    if [ -n "$tree" ]; then
      pick=$(printf '%s\n' "$tree" | grep -iP "(^|/)$stem\.(svg|png)$" | grep -i '\.svg$' | head -1 || true)
      [ -n "$pick" ] || pick=$(printf '%s\n' "$tree" | grep -iP "(^|/)$stem\.(png|svg)$" | head -1 || true)
      [ -n "$pick" ] || pick=$(printf '%s\n' "$tree" | grep -iP '(^|/)(icon|logo)\.svg$' | head -1 || true)
      [ -n "$pick" ] || pick=$(printf '%s\n' "$tree" | grep -iP '(^|/)(icon|logo)\.(png|svg)$' | head -1 || true)
      if [ -n "$pick" ] && curl -fsSL -o "$tmp/repoicon.${pick##*.}" "https://raw.githubusercontent.com/$gh/HEAD/$pick" 2>/dev/null; then
        local ifn="icon.${pick##*.}" isum; isum=$(sha256sum "$tmp/repoicon.${pick##*.}" | cut -d' ' -f1)
        cp -a "$tmp/repoicon.${pick##*.}" "$srcdest/$ifn" 2>/dev/null || true
        iconsrc="$iconsrc
        \"$ifn::https://raw.githubusercontent.com/$gh/HEAD/$pick\""
        iconsum="$iconsum
            '$isum'"
        if [[ "$ifn" == *.svg ]]; then
          iconinst="  install -Dm644 \"\$srcdir/$ifn\" \"\$pkgdir/usr/share/icons/hicolor/scalable/apps/$binname.svg\""
        else
          iconinst="  install -Dm644 \"\$srcdir/$ifn\" \"\$pkgdir/usr/share/pixmaps/$binname.png\""
        fi
        icon_entry="$binname"
        echo "repo icon: $pick"
      fi
    fi
  fi
  local pageurl="https://github.com/$gh" prov="GitHub releases"
  if [ -z "$gh" ]; then
    pageurl=$(printf '%s' "$aurl" | grep -oP '^https?://[^/]+')
    prov="direct download"
  fi
  # top-level .desktop shipped in archive? (full path; e.g. assets/pacseek.desktop)
  local topdesk=""
  if [ -z "$desktop" ]; then
    topdesk=$(grep -oP "^$top/[^/]+\.desktop$" "$listing" | head -1 || true)
    [ -z "$topdesk" ] && topdesk=$(grep -oP "^[^/]+\.desktop$" "$listing" | head -1 || true)
  fi
  # .desktop handling (except deb/appimage which do their own)
  local desk_install=""
  if [[ "$kind" != deb && "$kind" != appimage && "$kind" != cursortheme ]]; then
    local icon_entry="$binname"
    if [ -n "$icon_rel" ]; then
      if [[ "$icon_rel" == share/* ]]; then icon_entry="${icon_rel##*/}"; icon_entry="${icon_entry%.*}"
      else icon_entry="/opt/$name/$icon_rel"; fi
    fi
    # desk_src: path as seen from package() cwd (opttree/structured cd into $top)
    local desk_src="$topdesk" icon_install=""
    if [[ "$kind" != singlebin && "$kind" != rawbin && "$kind" != deb && "$kind" != appimage ]]; then
      desk_src="${topdesk##*/}"
    fi
    if [[ "$kind" == singlebin && -n "$icon_full" ]]; then
      local isize; isize=$(printf '%s' "$icon_full" | grep -oP '\d+x\d+' | head -1 || true)
      if [ -z "$isize" ]; then
        [[ "$icon_full" == *.svg ]] && isize="scalable" || isize="256x256"
      fi
      icon_install="  install -Dm644 \"$icon_full\" \"\$pkgdir/usr/share/icons/hicolor/$isize/apps/$binname.${icon_full##*.}\""
      icon_entry="$binname"
    fi
    # terminal apps need Terminal=true or launchers (rofi etc.) open nothing.
    # probe the launcher: scripts and GUI-linked ELFs -> false, else true.
    local terminal="true"
    if [ -z "$topdesk" ] && [ -z "$desktop" ]; then
      local probe="$tmp/probe-bin" ok=0 member=""
      if [ "$kind" = rawbin ]; then
        if cp -a "$final" "$probe" 2>/dev/null; then ok=1; fi
      else
        case "$kind" in
          opttree|structured) member="$top/${binpath:-bin/$binname}" ;;
          singlebin) member="${binpath:-$binname}" ;;
        esac
        if [ -n "$member" ]; then
          if bsdtar -xOf "$tmp/$asset" "$member" > "$probe" 2>/dev/null; then ok=1; fi
        fi
      fi
      if [ "$ok" = 1 ]; then
        if head -c 2 "$probe" 2>/dev/null | grep -q '#!'; then terminal="false"
        elif ldd "$probe" 2>/dev/null | grep -qiE 'libgtk|libqt[56]|libwx|libx11|libwayland|libglfw|libEGL|libGL\.|libvulkan'; then terminal="false"
        fi
      fi
      rm -f "$probe"
    fi
    if [ -n "$topdesk" ]; then
      desk_install="  install -Dm644 \"$desk_src\" \"\$pkgdir/usr/share/applications/$binname.desktop\"
  sed -i \"s|^Exec=.*|Exec=/usr/bin/$binname|\" \"\$pkgdir/usr/share/applications/$binname.desktop\""
      if [[ "$icon_entry" == /* ]]; then
        desk_install="$desk_install
  sed -i \"s|^Icon=.*|Icon=$icon_entry|\" \"\$pkgdir/usr/share/applications/$binname.desktop\""
      fi
    elif [ -z "$desktop" ] && [[ "$kind" != cursortheme ]]; then
      cat > "$d/$binname.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$display
Exec=/usr/bin/$binname
Icon=$icon_entry
Terminal=$terminal
Categories=Utility;
EOF
      desk_install="  install -Dm644 \"\$startdir/$binname.desktop\" \"\$pkgdir/usr/share/applications/$binname.desktop\""
    fi
  fi

  case "$kind" in
    structured)
      cat > "$d/PKGBUILD" <<EOF
# Maintainer: $(whoami) <$(whoami)@localhost> (generated by pacgrab install)
pkgname=$name
pkgver=$ver
pkgrel=1
pkgdesc="$binname local build ($prov)"
arch=('x86_64')
url="$pageurl"
license=($lic)
depends=('hicolor-icon-theme' 'gcc-libs' 'glibc')
options=('!strip')
_github="$gh"
_pacgrab_url="$aurl"
source=("$asset::$srcurl"$iconsrc)
sha256sums=('$sum'$iconsum)

package() {
  cd "$top"
  install -Dm755 bin/$binname -t "\$pkgdir/usr/bin/"
  cp -a share "\$pkgdir/usr/"
$desk_install
$iconinst
}
EOF
      ;;
    appimage)
      cat > "$d/PKGBUILD" <<EOF
