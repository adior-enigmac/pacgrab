cmd_fix_conflicts() { # remove unowned files that any pacgrab package would install
  local d removed=0 p f
  for d in "$BASE"/*/; do
    [ -f "$d/PKGBUILD" ] || continue
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      while IFS= read -r f; do
        [ -n "$f" ] || continue
        echo "removing unowned conflict: $f  (would block $(basename "$p"))"
        sudo rm -f "$f" && removed=$((removed+1))
      done < <(conflicts_of "$p")
    done < <(built_pkgs "$d")
  done
  echo "fix-conflicts: removed $removed orphaned file(s)."
}

_restore_tty() { # after reading a prompt from a pipe, give stdin back to the
  # terminal - otherwise the sudo in the next step has no tty to ask with
  [ -t 0 ] && return 0
  if { : </dev/tty; } 2>/dev/null; then exec 0</dev/tty; fi
  return 0
}

yesno() { # $1=prompt -> 0 only on an explicit yes (EOF/non-tty = no)
  # printf (not `read -p`): read -p hides the prompt unless stdin is a tty
  printf '%s [y/N] ' "$1" >&2
  local ans=""
  if ! read -r ans; then _restore_tty; return 1; fi
  _restore_tty
  [[ "$ans" =~ ^[Yy]$ ]]
}

aur_helper() { command -v paru 2>/dev/null || command -v yay 2>/dev/null; }

# $1=AUR PKGBUILD -> its source[]/source_x86_64[] entries, one per line.
# Elements are already expanded: bash expands them when the array is assigned
# during `source`, so no second eval is needed.
aur_srcurls() {
  bash -c 'source "$1" 2>/dev/null || exit 0
    for s in ${source[@]+"${source[@]}"} ${source_x86_64[@]+"${source_x86_64[@]}"}; do
      printf "%s\n" "${s##*::}"
    done' _ "$1" 2>/dev/null
}

aur_fallback() { # $1=pkg: nothing grabbable -> ask before using the AUR helper
  local pkg="$1" helper
  # adopt/migrate mode: the package is already installed, so never prompt to
  # reinstall it through an AUR helper - just leave it managed by the AUR
  if [ "${PACGRAB_ADOPT:-0}" = 1 ]; then
    echo "$pkg: no grabbable download - leaving the installed AUR package as-is"
    return 1
  fi
  helper=$(aur_helper) || { echo "$pkg: no AUR helper (paru/yay) installed"; return 1; }
  if yesno "$pkg: no grabbable download - install through the AUR with ${helper##*/}?"; then
    wait_lock || return 1
    "$helper" -S --noconfirm "$pkg"
    return $?
  fi
  echo "$pkg: skipped (AUR fallback declined)"
  return 1
}

# -S <pkg> [...] [--no-build] : AUR replacement. Find where the project itself
# publishes downloads and build one of those into a pacgrab recipe; only hand
# off to the AUR helper when the upstream has no normal download we can grab.
cmd_S() {
  need curl; need jq
  local nobuild=0 fail=0 a pkg
  local -a pkgs=()
  for a in "$@"; do
    case "$a" in
      --no-build) nobuild=1 ;;
      -*) die "unknown option: $a (usage: $0 -S <pkgname> [...] [--no-build])" ;;
      *) pkgs+=("$a") ;;
    esac
  done
  [ ${#pkgs[@]} -ge 1 ] || die "usage: $0 -S <pkgname> [...] [--no-build]"
  for pkg in "${pkgs[@]}"; do
    cmd_S_one "$pkg" "$nobuild" || fail=1
  done
  return $fail
}

cmd_S_one() { # $1=pkgname  $2=nobuild(0/1)
  local pkg="$1" nobuild="${2:-0}"
  local json base name aurl tmp npkgs cand pick ghurl
  local -a addargs=()

  # 1. already one of ours -> just (re)build it
  if [ -f "$BASE/$pkg/PKGBUILD" ]; then
    if [ "$nobuild" = 1 ]; then echo "$pkg: already a pacgrab recipe (build skipped)"; return 0; fi
    echo "$pkg: already a pacgrab recipe, rebuilding"
    cmd_build "$pkg"; return $?
  fi

  # 2. any sync repo (cachyos-*, core, extra, ...) belongs to pacman -
  #    this only replaces the AUR. $REPO_NAME is pacgrab's own repo.
  local -a sync_repos=()
  mapfile -t sync_repos < <(pacman -Si "$pkg" 2>/dev/null | awk -F': *' '/^Repository/ {print $2}')
  if [ ${#sync_repos[@]} -gt 0 ]; then
    local r is_local=1
    for r in "${sync_repos[@]}"; do [ "$r" != "$REPO_NAME" ] && is_local=0; done
    if [ "$is_local" = 0 ]; then
      echo "$pkg: official package (${sync_repos[*]}) - pacman manages it, not the AUR"
      if yesno "$pkg: install from the official repos with pacman?"; then
        wait_lock || return 1
        sudo pacman -S --noconfirm "$pkg" || return 1
      fi
      return 0
    fi
    echo "$pkg: provided by the pacgrab [$REPO_NAME] repo (build it with: pacgrab build $pkg)"
    return 0
  fi

  # 3. the AUR only tells us where the project lives - never its payload
  json=$(curl -fsSL -G --data-urlencode "arg[]=$pkg" "https://aur.archlinux.org/rpc/v5/info") \
    || { echo "$pkg: AUR lookup failed"; return 1; }
  jq -e '.resultcount > 0' >/dev/null <<<"$json" \
    || { echo "$pkg: not in the official repos and not in the AUR"; return 1; }
  base=$(jq -r '.results[0].PackageBase' <<<"$json")
  name=$(jq -r '.results[0].Name' <<<"$json")
  aurl=$(jq -r '.results[0].URL' <<<"$json")
  echo "$pkg: in the AUR as $base (upstream: ${aurl:-unknown})"
  # 1 if this recipe dir isn't there yet, so a failed grab can undo itself
  local made_dir=1; [ -e "$BASE/$name" ] && made_dir=0

  tmp=$(mktemp -d "${TMPDIR:-/tmp}/pacgrab-S-XXXXXX")
  if ! curl -fsSL "https://aur.archlinux.org/cgit/aur.git/plain/PKGBUILD?h=$base" -o "$tmp/PKGBUILD"; then
    rm -rf "$tmp"; echo "$pkg: cannot fetch the AUR PKGBUILD for $base"; return 1
  fi

  # split packages don't fit a single-package recipe
  npkgs=$(bash -c 'source "$1" 2>/dev/null || { echo 0; exit 0; }
    if declare -p pkgname 2>/dev/null | grep -q "declare -a"; then echo "${#pkgname[@]}"; else echo 1; fi' _ "$tmp/PKGBUILD")
  if [ "${npkgs:-0}" -gt 1 ] 2>/dev/null; then
    rm -rf "$tmp"
    echo "$pkg: split AUR package ($npkgs pkgs in one PKGBUILD) - needs the AUR"
    aur_fallback "$pkg"; return $?
  fi

  # 4. a real, prebuilt download from the project itself?
  cand=$(aur_srcurls "$tmp/PKGBUILD")
  pick=$(printf '%s\n' "$cand" | grep -iP '^https?://' \
    | grep -viP '\.git($|\?)|git\+|/(archive|tarball|zipball)/|/tags/|pypi\.|pythonhosted|crates\.io|\.patch($|\?)|\.diff($|\?)|\.hook($|\?)|\.install($|\?)|\.sig($|\?)|\.asc($|\?)' \
    | grep -iP 'releases?/|x86_64|amd64|aarch64|arm64|linux|appimage|\.deb$' \
    | grep -iP '\.(AppImage|deb|tgz|tar\.(gz|xz|bz2|zst|lzma)|zip|7z|run|zst|xz|bz2)$' \
    | grep -viP '\.pkg\.(tar\.)?(zst|xz|gz|bz2)$' | head -1 || true)
  if [ -z "$pick" ] && printf '%s\n' "$cand" | grep -qiP '\.pkg\.(tar\.)?(zst|xz|gz|bz2)$'; then
    echo "$pkg: upstream ships only a prebuilt Arch package - not recipe-able"
  fi
  rm -rf "$tmp"

  if [ -n "$pick" ]; then
    echo "$pkg: grabbing the project's own download: $pick"
    addargs=("$pick" "$name"); [ "$nobuild" = 1 ] && addargs+=(--no-build)
    if ( cmd_add "${addargs[@]}" ); then return 0; fi
    echo "$pkg: could not make a recipe from that URL"
    if [ "$made_dir" = 1 ]; then rm -rf "$BASE/$name"; fi
    aur_fallback "$pkg"; return $?
  fi

  # 5. AUR source is only a checkout? try the project's GitHub releases.
  #    Look at the real source (git+/archive URLs), not just the homepage,
  #    and only if the release ships something that looks like an app -
  #    some projects' "releases" are just images or source snapshots.
  local repo_hint="$aurl" rel assets
  if printf '%s\n' "$cand" | grep -qiP 'github\.com'; then
    repo_hint=$(printf '%s\n' "$cand" | grep -iP 'github\.com' | head -1)
  fi
  if [[ "$repo_hint" =~ github\.com[:/]([^/]+/[^/?#]+) ]]; then
    ghurl="${BASH_REMATCH[1]}"; ghurl="${ghurl%.git}"
    rel=$(curl -fsSL --max-time 20 "https://api.github.com/repos/$ghurl/releases/latest" 2>/dev/null || true)
    assets=$(printf '%s' "$rel" | jq -r '.assets[]?.name' 2>/dev/null || true)
    if printf '%s\n' "$assets" | grep -qiP '\.(AppImage|deb|tgz|tar\.(gz|xz|bz2|zst)|zip|7z|run|zst|xz)$|linux|x86_64|amd64|arm64'; then
      echo "$pkg: AUR source is only a checkout - using github.com/$ghurl releases"
      addargs=("https://github.com/$ghurl" "$name"); [ "$nobuild" = 1 ] && addargs+=(--no-build)
      if ( cmd_add "${addargs[@]}" ); then return 0; fi
      echo "$pkg: could not turn a GitHub release into a recipe"
    elif [ -n "$assets" ]; then
      echo "$pkg: github.com/$ghurl releases carry no app download ($(printf '%s' "$assets" | tr '\n' ' '))"
    else
      echo "$pkg: github.com/$ghurl publishes no release assets"
    fi
  fi

  # 6. nothing we can grab -> the AUR (drop any half-made recipe first)
  if [ "$made_dir" = 1 ]; then rm -rf "$BASE/$name"; fi
  aur_fallback "$pkg"
}

# migrate : turn every installed AUR package into a pacgrab recipe. Walks
# `pacman -Qm` (foreign = installed but not in any sync repo = the AUR ones)
# and runs each through the same grabber as `-S`, in adopt mode: nothing is
# rebuilt (they are already installed) and the AUR-helper fallback is skipped.
# Run `pacgrab build-all` afterwards if you want them rebuilt as pacgrab pkgs.
cmd_migrate() {
  need curl; need jq
  local pkg ver row made=0 already=0 aur=0
  # adopted packages are already installed - never prompt to reinstall via AUR
  PACGRAB_ADOPT=1
  export PACGRAB_ADOPT
  local -a pkgs=()
  # pacman -Qm: "<name> <version>" for every foreign (AUR) package
  mapfile -t pkgs < <(pacman -Qm 2>/dev/null | awk '{print $1"\t"$2}')
  if [ ${#pkgs[@]} -eq 0 ]; then
    echo "no installed AUR packages found - nothing to migrate"
    return 0
  fi
  echo "migrating ${#pkgs[@]} installed AUR package(s) into pacgrab recipes..."
  echo
  for row in "${pkgs[@]}"; do
    pkg=${row%%$'\t'*}; ver=${row#*$'\t'}
    [ -n "$pkg" ] || continue
    # a recipe that already exists is left alone
    if [ -f "$BASE/$pkg/PKGBUILD" ]; then
      echo "$pkg: already a pacgrab recipe"; already=$((already+1)); continue
    fi
    if cmd_S_one "$pkg" 1 >/dev/null 2>&1; then
      if [ -f "$BASE/$pkg/PKGBUILD" ]; then
        echo "$pkg: migrated -> $BASE/$pkg"; made=$((made+1))
      else
        echo "$pkg: no recipe created (left on the AUR)"; aur=$((aur+1))
      fi
    else
      echo "$pkg: could not migrate (left on the AUR)"; aur=$((aur+1))
    fi
  done
  echo
  echo "migrate: $made new recipe(s), $already already pacgrab, $aur left on the AUR"
  if [ "$made" -gt 0 ]; then
    echo "run 'pacgrab list' to see them, 'pacgrab build-all' to rebuild as pacgrab pkgs"
  fi
  return 0
}

cmd_prune() { # remove recipe dirs for packages that are not installed
  local yes=0; [ "${1:-}" = "--yes" ] && yes=1
  local dead=() d name pns p info row any _origin
  local -a all=() rows=()
  # one process for every PKGBUILD instead of `basename` + `bash -c` per recipe
  while IFS=$'\t' read -r d info _origin; do
    [ -n "$d" ] || continue
    name=${d##*/}
    # pkg_report reports "? ?" when the PKGBUILD would not source (syntax error
    # from a half-saved edit) - that is NOT "not installed", so never delete it
    if [ "$info" = "? ?" ]; then
      echo "$name: skipped (PKGBUILD not sourceable - fix it first)"
      continue
    fi
    pns=${info% *}
    rows+=("$name|$pns")
    for p in $pns; do all+=("$p"); done
  done < <(pkg_report "$BASE"/*/)
  load_installed "${all[@]}"   # one pacman call instead of one per package
  for row in "${rows[@]}"; do
    name=${row%%|*}; pns=${row#*|}
    any=0
    for p in $pns; do
      if [ -n "${INSTALLED[$p]:-}" ]; then any=1; fi
    done
    if [ "$any" -eq 0 ]; then dead+=("$name"); fi
  done
  [ ${#dead[@]} -gt 0 ] || { echo "nothing to prune"; return 0; }
  echo "not installed, removing recipes:"
  printf '  %s\n' "${dead[@]}"
  if [ "$yes" -eq 0 ]; then
    ans=""
    read -rp "delete ${#dead[@]} directorie(s)? [y/N] " ans || true
    [[ "$ans" =~ ^[Yy]$ ]] || { echo "aborted"; return 0; }
  fi
  for name in "${dead[@]}"; do rm -rf "$BASE/$name"; done
  echo "pruned ${#dead[@]}."
}

cmd_refresh() { # refresh <name>: regenerate its PKGBUILD from the original URL with current code
  [ $# -eq 1 ] || die "usage: $0 refresh <name>"
  local d="$BASE/$1"
  [ -f "$d/PKGBUILD" ] || die "no PKGBUILD in $d"
  local u
  u=$(bash -c 'source "$1/PKGBUILD" 2>/dev/null || exit 1
    [ -n "${_pacgrab_url:-}" ] && { echo "$_pacgrab_url"; exit 0; }
    # arch-specific recipes declare source_x86_64=(); source[] is empty outside
    # makepkg, so fall back to the arch (and any) arrays
    set -- "${source[@]}"
    [ $# -gt 0 ] || set -- "${source_x86_64[@]}"
    [ $# -gt 0 ] || set -- "${source_any[@]}"
    for s in "$@"; do
      [ -n "$s" ] || continue
      u="${s##*::}"; u=$(eval echo "\"$u\"")
      # *://* not http*: VCS sources start with "git+", which an anchored http*
      # rejected - every git recipe died as "no downloadable source"
      case "$u" in *icon.png|*icon.svg) continue;; *://*) echo "$u"; break;; esac
    done' _ "$d") || die "cannot determine original URL for $1"
  [ -n "$u" ] || die "no downloadable source in $d/PKGBUILD"
  # a VCS recipe is not generated from a download URL - say so instead of handing
  # cmd_add something it can only reject
  case "$u" in
    git+*|svn+*|hg+*|bzr+*) die "$1: VCS recipe - not regenerable from a URL (edit the PKGBUILD instead)" ;;
  esac
  echo "original URL: $u"
  local bak="$d.refresh-bak"
  rm -rf "$bak"; mv "$d" "$bak"
  # an interrupt between this mv and the end used to leave the recipe parked in
  # $bak, where the NEXT refresh's `rm -rf "$bak"` destroyed the only copy
  local restore='[ -d "$bak" ] && [ ! -f "$d/PKGBUILD" ] && { rm -rf "$d"; mv "$bak" "$d"; echo "refresh interrupted - restored $1 from backup" >&2; }'
  trap "$restore" EXIT
  trap "$restore; exit 130" INT
  trap "$restore; exit 143" TERM
  # "success" must mean a sourceable PKGBUILD exists, not merely cmd_add exiting 0
  if cmd_add "$u" "$1" --no-build && [ -f "$d/PKGBUILD" ] \
     && bash -c 'source "$1/PKGBUILD" 2>/dev/null' _ "$d"; then
    trap - EXIT INT TERM
    # keep the installed version stamp if user hadn't bumped (regenerate keeps code, not version)
    rm -rf "$bak"; echo "refreshed $1 (run: $0 build $1)"
  else
    trap - EXIT INT TERM
    rm -rf "$d"; mv "$bak" "$d"; die "refresh failed, restored backup"
  fi
}

cmd_sync() { # $@=names (default: all): install recipe desktops+icons directly, no rebuild
  local targets=() t
  if [ $# -eq 0 ]; then
    for d in "$BASE"/*/; do
      if [ -f "$d/PKGBUILD" ]; then
        t=${d%/}; targets+=("${t##*/}")
      fi
    done
  else
    targets=("$@")
  fi
  local fail=0 changed=0 name d desk base icon iconfile src url ext inst
  local first want have info shipped names n f line _origin
  local -A FIRST=() WANT=() NAMES=() DESK=()
  local -a firsts=() deskpaths=() dirs=()
  # resolve each recipe's package name(s), wanted version and desktop file in
  # ONE process, then ask pacman exactly twice for the whole run: installed
  # versions, and who owns those desktop paths. Per recipe this used to be a
  # `bash -c`, a `find|head`, a `grep|head` and a `basename` - ~4 forks x 19.
  for name in "${targets[@]}"; do
    if [ -f "$BASE/$name/PKGBUILD" ]; then dirs+=("$BASE/$name"); fi
  done
  while IFS=$'\t' read -r d info _origin; do
    [ -n "$d" ] || continue
    name=${d##*/}
    names=${info% *}
    FIRST[$name]=${names%% *}
    WANT[$name]=${info##* }
    NAMES[$name]=$names
    firsts+=("${names%% *}")
    desk=""
    for f in "$d"/*.desktop; do
      if [ -f "$f" ]; then desk=$f; break; fi
    done
    DESK[$name]=$desk
    if [ -n "$desk" ]; then
      deskpaths+=("/usr/share/applications/${desk##*/}")
    fi
  done < <(pkg_report "${dirs[@]}")
  load_installed "${firsts[@]}"
  load_owned "${deskpaths[@]}"
  for name in "${targets[@]}"; do
    d="$BASE/$name"
    [ -f "$d/PKGBUILD" ] || { echo "$name: no recipe, skipping"; fail=1; continue; }
    desk=${DESK[$name]:-}
    if [ -z "$desk" ]; then
      # shipped-desktop recipe (desktop lives in the tarball, not the recipe dir):
      # in sync iff installed version matches the recipe
      first=${FIRST[$name]}; want=${WANT[$name]}
      have=${INSTALLED[$first]:-}
      if [ -n "$have" ] && [ "$have" = "$want" ]; then
        echo "$name already in sync ($have)"
      else
        echo "$name: shipped desktop needs a build (run pacgrab build $name) [have: ${have:-none}, recipe: $want]"
        fail=1
      fi
      continue
    fi
    base=${desk##*/}
    inst="/usr/share/applications/$base"
    # first Icon= line, read in bash instead of `grep|head` (2 forks x 19)
    icon=""
    while IFS= read -r line; do
      case "$line" in
        Icon=*) icon=${line#Icon=}; icon=${icon%$'\r'}; break ;;
      esac
    done < "$desk"
    # never hand-install a path our package owns: an unowned copy left on disk
    # makes the next `pacman -U` fail with "exists in filesystem". If the
    # built package ships it, treat the package as the source of truth.
    # (owner lookup is preloaded for every recipe in one `pacman -Qo`; the
    # full file list is only built further down, at the icon check)
    if ships_path "${NAMES[$name]}" "$inst"; then
      first=${FIRST[$name]}; want=${WANT[$name]}
      have=${INSTALLED[$first]:-}
      if [ -n "$have" ] && [ "$have" = "$want" ]; then
        echo "$name already in sync ($have, desktop provided by package)"
      else
        echo "$name: desktop ships with the package, needs a build (run pacgrab build $name) [have: ${have:-none}, recipe: $want]"
        fail=1
      fi
      continue
    fi
    # icon already good?
    iconfile=""
    if [[ "$icon" == /* ]]; then
      [ -f "$icon" ] && iconfile="absolute"
    elif [ -n "$icon" ]; then
      [ -f "/usr/share/pixmaps/$icon.png" ] && iconfile="pixmaps"
      [ -f "/usr/share/pixmaps/$icon.svg" ] && iconfile="pixmaps"
      [ -f "/usr/share/icons/hicolor/scalable/apps/$icon.svg" ] && iconfile="hicolor"
      [ -f "/usr/share/icons/hicolor/256x256/apps/$icon.png" ] && iconfile="hicolor"
    else
      iconfile="none-needed"
    fi
    if cmp -s "$desk" "$inst" 2>/dev/null && [ -n "$iconfile" ]; then
      first=${FIRST[$name]}; want=${WANT[$name]}
      have=${INSTALLED[$first]:-}
      echo "$name already in sync (${have:-$want})"
      continue
    fi
    echo "syncing $base..."
    sudo install -Dm644 "$desk" "$inst" || { fail=1; continue; }
    changed=1
    if [[ "$icon" == /* ]]; then
      [ -f "$icon" ] || echo "$name: WARNING $icon missing on disk (payload not installed?)"
    elif [ -n "$icon" ] && [ -z "$iconfile" ]; then
        # if the package ships this icon, only a build may install it
        # (this is the rare path - build the package's full file list here,
        # not once per recipe on every run)
        shipped=$(recipe_ships "$d") || shipped=""
        if printf '%s\n' "$shipped" | grep -qE "/(icons/hicolor/[^/]+/apps|pixmaps)/$icon\.(svg|png)$"; then
          echo "$name: icon provided by package (run pacgrab build $name)"
          continue
        fi
        url=$(grep -oP '"icon\.(png|svg)::\K[^"]+' "$d/PKGBUILD" | head -1 || true)
        if [ -n "$url" ]; then
          ext="${url%%\?*}"; ext="${ext##*.}"
          src="${TMPDIR:-/tmp}/pacgrab-icon-$icon.$ext"
          echo "fetching icon for $icon..."
          if curl -fsSL -o "$src" "$url"; then
            if [[ "$src" == *.svg ]]; then
              sudo install -Dm644 "$src" "/usr/share/icons/hicolor/scalable/apps/$icon.svg" || fail=1
            else
              sudo install -Dm644 "$src" "/usr/share/pixmaps/$icon.png" || fail=1
            fi
            rm -f "$src"
          else
            echo "$name: WARNING icon download failed"; fail=1
          fi
        else
          echo "$name: WARNING no icon file for '$icon' and none bundled (run pacgrab build $name)"
        fi
    fi
  done
  if [ "$changed" -eq 1 ]; then
    sudo update-desktop-database /usr/share/applications 2>/dev/null || true
    sudo gtk-update-icon-cache -qf /usr/share/icons/hicolor 2>/dev/null || true
  fi
  return $fail
}

cmd_update() { # update <pkg>: github via API; floating direct URLs via re-resolve; pinned URLs need manual bump
  [ $# -eq 1 ] || die "usage: $0 update <pkgname>"
  local d="$BASE/$1" before after gh
  [ -f "$d/PKGBUILD" ] || die "no PKGBUILD in $d"
  before=$( ( source "$d/PKGBUILD" 2>/dev/null && echo "$pkgver" ) ) \
    || die "$d/PKGBUILD is not sourceable - fix it first"
  gh=$(grep -oP '^_github="\K[^"]+' "$d/PKGBUILD" || true)
  if [ -z "$gh" ]; then
    local u
    u=$(bash -c 'source "$1/PKGBUILD" 2>/dev/null || exit 1
      [ -n "${_pacgrab_url:-}" ] && { echo "$_pacgrab_url"; exit 0; }
      # arch-specific recipes declare source_x86_64=(); sourced outside makepkg
      # that leaves source[] empty, so skwd-suite-bin died as "no downloadable
      # source" - fall back to the arch (and any) arrays
      set -- "${source[@]}"
      [ $# -gt 0 ] || set -- "${source_x86_64[@]}"
      [ $# -gt 0 ] || set -- "${source_any[@]}"
      for s in "$@"; do
        [ -n "$s" ] || continue
        u="${s##*::}"; u=$(eval echo "\"$u\"")
        # not http*: VCS sources are "git+https://..." - an anchored http* match
        # rejected every git recipe and died with "no downloadable source"
        case "$u" in *icon.png|*icon.svg) continue;; *://*) echo "$u"; break;; esac
      done' _ "$d")
    [ -n "$u" ] || die "no downloadable source in $d/PKGBUILD"
    # VCS sources (git+/svn+/hg+/bzr+) have no URL to re-resolve: either pkgver()
    # recomputes it at build, or a #tag= pins it to pkgver. `refresh` cannot
    # regenerate such a recipe, so report the state instead of dying/refetching.
    case "$u" in
      git+*|svn+*|hg+*|bzr+*)
        if grep -q '^pkgver()' "$d/PKGBUILD" 2>/dev/null; then
          echo "$1: VCS recipe - pkgver set at build (run: $0 build $1)"
        else
          echo "$1: VCS source pinned at $before (run: $0 edit $1, then build)"
        fi
        return 0 ;;
    esac
    if printf '%s' "$u" | grep -qP '\d+\.\d+'; then
      # pinned URL: only auto-detect via feed if recipe has _check_url/_check_regex
      cu=$(grep -oP '^_check_url="\K[^"]+' "$d/PKGBUILD" 2>/dev/null || true)
      if [ -n "$cu" ]; then
        cr=$(grep -oP '^_check_regex=\K.*' "$d/PKGBUILD" 2>/dev/null | sed "s/^'//; s/'$//" || true)
        latest=$(curl -fsSL --compressed --max-time 30 "$cu" 2>/dev/null | grep -oP "$cr" | head -1 || true)
        if [ -n "$latest" ] && [ "$(norm_ver "$latest")" != "$(norm_ver "$before")" ]; then
          echo "$1: $before -> $latest available (re-pacgrab the new link)"
        else
          echo "$1 already latest ($before)"
        fi
        return 0
      fi
      echo "$1: version-pinned URL - bump manually (pacgrab edit $1, or re-pacgrab the new link)"
      return 0
    fi
    cmd_refresh "$1" >/dev/null || { echo "$1: refresh failed (see error above)"; return 1; }
    after=$( ( source "$d/PKGBUILD" 2>/dev/null && echo "$pkgver" ) ) \
      || die "$1: refresh left an unreadable PKGBUILD - run: $0 refresh $1"
    if [ "$before" != "$after" ]; then
      echo "$1: $before -> $after"; cmd_build "$1"
    else
      echo "$1 already latest ($before)"
    fi
    return 0
  fi
  # cmd_update prints its own status line below - silence cmd_bump's (it echoes
  # "already at"/"x -> y" too), errors still land on stderr via die()
  cmd_bump "$1" >/dev/null || { echo "$1: bump failed (see error above)"; return 1; }
  after=$( ( source "$d/PKGBUILD" 2>/dev/null && echo "$pkgver" ) ) \
    || die "$1: bump left an unreadable PKGBUILD - run: $0 edit $1"
  if [ "$before" != "$after" ]; then
    cmd_build "$1"
  else
    echo "$1 already latest ($before)"
  fi
}

cmd_update_all() { # bump+rebuild every _github package that is outdated
  local n=0 failed=()
  for d in "$BASE"/*/; do
    [ -f "$d/PKGBUILD" ] || continue
    grep -q '^_github=' "$d/PKGBUILD" || continue
    local name; name=$(basename "$d")
    echo "=== $name ==="
    if cmd_update "$name"; then
      n=$((n+1))
    else
      failed+=("$name")
    fi
  done
  cmd_repo >/dev/null 2>&1 || true
  echo "update-all done: $n checked, ${#failed[@]} failed${failed:+ (${failed[*]})}"
}

cmd_timer_install() { # install systemd user timer for weekly autoupdates
  local unitdir="$HOME/.config/systemd/user"
  mkdir -p "$unitdir" "$HOME/.local/share/pacgrab"
  cat > "$unitdir/pacgrab-update.service" <<EOF
[Unit]
Description=pacgrab autoupdate (GitHub releases -> rebuild local packages)

[Service]
Type=oneshot
ExecStart=$BASE/pacgrab update-all
StandardOutput=append:%h/.local/share/pacgrab/update.log
StandardError=append:%h/.local/share/pacgrab/update.log
EOF
  cat > "$unitdir/pacgrab-update.timer" <<EOF
[Unit]
Description=Weekly pacgrab autoupdate

[Timer]
OnCalendar=weekly
Persistent=true

[Install]
WantedBy=timers.target
EOF
  systemctl --user daemon-reload
  systemctl --user enable --now pacgrab-update.timer
  echo "timer installed (weekly). log: ~/.local/share/pacgrab/update.log"
}

cmd_timer_remove() {
  systemctl --user disable --now pacgrab-update.timer 2>/dev/null || true
  rm -f "$HOME/.config/systemd/user/pacgrab-update.service" "$HOME/.config/systemd/user/pacgrab-update.timer"
  systemctl --user daemon-reload
  echo "timer removed"
}

# recipe [pkg...] : look inside the recipes. No args = one line per recipe;
# names given = print those PKGBUILDs in full.
cmd_recipe() {
  local d p info n total status names origin pkg fail=0 r
  local -a rows=() all=()
  if [ $# -eq 0 ]; then
    local found=0
    # one process for every PKGBUILD: the old path forked 4x per recipe
    # (`bash -c` + grep/head/grep) - ~1s of spawns under load, ~50ms here.
    # Sourcing also resolves variables/split arrays (grep can't), and
    # `makepkg --printsrcinfo` does the same at 2.4s per recipe.
    while IFS=$'\t' read -r d info origin; do
      [ -n "$d" ] || continue
      found=1
      names=${info% *}
      rows+=("$d|$names|$origin")
      for n in $names; do all+=("$n"); done
    done < <(pkg_report "$BASE"/*/)
    [ "$found" = 1 ] || { echo "no recipes in $BASE"; return 0; }
    # one pacman call for every name in every recipe
    load_installed "${all[@]}"
    printf '%-26s %-46s %-6s %s\n' "RECIPE" "PKGNAME(S)" "FROM" "STATUS"
    for r in "${rows[@]}"; do
      d=${r%%|*}; r=${r#*|}; names=${r%%|*}; origin=${r#*|}
      if [[ "$names" == *" "* ]]; then
        n=0; total=0
        for p in $names; do
          total=$((total+1))
          if [ -n "${INSTALLED[$p]:-}" ]; then n=$((n+1)); fi
        done
        status="$n/$total installed"
      elif [ -n "${INSTALLED[$names]:-}" ]; then
        status="$names ${INSTALLED[$names]}"
      else
        status="not installed"
      fi
      printf '%-26s %-46s %-6s %s\n' "${d##*/}" "${names% }" "$origin" "$status"
    done
    return 0
  fi
  for pkg in "$@"; do
    p="$BASE/$pkg/PKGBUILD"
    if [ ! -f "$p" ]; then echo "$pkg: no recipe in $BASE" >&2; fail=1; continue; fi
    echo "=== $p"
    cat "$p"
    echo
  done
  return $fail
}

cmd_help() {
  echo "pacgrab - paste a URL, get the app (~/pacgrab)"
  echo
  local cmds=(
    "-S <pkg> [...]|AUR replacement: grab the project's own download (else AUR)"
    "<url>|install app from a link (GitHub release or direct download)"
    "list|show managed packages and install status"
    "recipe [p ...]|look inside recipes: one line each, or print full PKGBUILD(s)"
    "build <p> [...]|rebuild + reinstall one or more packages"
    "build-all|rebuild + reinstall everything"
    "uninstall <name>|remove the app (recipe stays; add --purge to delete it too)"
    "update <name>|bump + rebuild one GitHub package"
    "sync [name ...]|install recipe desktops+icons directly, no rebuild"
    "refresh <name>|regenerate recipe from its URL with current code"
    "migrate|make pacgrab recipes from every installed AUR package"
    "fix-conflicts|delete unowned files that would block pacgrab package installs"
    "prune [--yes]|delete recipes for apps that are not installed"
    "update-all|bump + rebuild all outdated GitHub packages"
    "check|show which GitHub packages have updates"
    "bump <p> [ver]|bump version: GitHub API or explicit version"
    "edit <name>|open the PKGBUILD in $EDITOR"
    "new <name> O/R|scaffold a recipe by hand from GitHub owner/repo"
    "clean|delete build leftovers and partial downloads"
    "repo|regenerate the local pacman repo database"
    "setup|one-time: create repo db + add [pacgrab] to /etc/pacman.conf"
    "timer-install|weekly autoupdates via a systemd timer"
    "timer-remove|remove the autoupdate timer"
  )
  local w=0 c t
  for c in "${cmds[@]}"; do t=${c%%|*}; [ "${#t}" -gt "$w" ] && w=${#t}; done
  for c in "${cmds[@]}"; do printf "  pacgrab %-${w}s  %s\n" "${c%%|*}" "${c#*|}"; done
  echo
  echo "GitHub links autoupdate. Other links install fine but bump manually."
}

case "${1:-help}" in
  help|-h|--help) cmd_help ;;
  list) cmd_list ;;
  recipe|recipes) shift; cmd_recipe "$@" ;;
  install|add) shift; cmd_add "$@" ;;
  -S) shift; cmd_S "$@" ;;
  http*://*) cmd_add "$@" ;; # bare URL -> install
  build) shift; cmd_build "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  build-all) cmd_build_all ;;
  bump) shift; cmd_bump "$@" ;;
  update) shift; cmd_update "$@" ;;
  sync) shift; cmd_sync "$@" ;;
  refresh) shift; cmd_refresh "$@" ;;
  migrate) cmd_migrate ;;
  fix-conflicts) cmd_fix_conflicts ;;
  prune) shift; cmd_prune "$@" ;;
  update-all) cmd_update_all ;;
  check) cmd_check ;;
  edit) shift; cmd_edit "$@" ;;
  new) shift; cmd_new "$@" ;;
  clean) cmd_clean ;;
  repo) cmd_repo ;;
  setup) cmd_setup ;;
  timer-install) cmd_timer_install ;;
  timer-remove) cmd_timer_remove ;;
  *) cmd_help; exit 1;;
esac
